# ==============================================================================
# Lumina Edge .gitignore
# Things you should NEVER commit: large binaries, cache, build output, secrets
# ==============================================================================

# Model files (all formats) — these are 500MB-10GB+ each
models/*.gguf
models/*.safetensors
models/*.bin
models/*.pth
models/*.pt
models/*.onnx
models/*.h5
models/*.pb

# Entire model directories except .gitkeep
models/*/
!models/.gitkeep

# Virtual environments — all variants
venv/
env/
.venv/
.env/
venv_rag/
venv_pipeline/
venv_mlx/

# Build directories
bin/
build/
dist/

# Logs and cache
*.log
*.cache
.cache/
logs/
.lumina_run/
vectordb/
vectordb/*.bin
*.sqlite3

# UI build artifacts
ui/dist/
ui/build/
ui/node_modules/
ui/.env
ui/.env.local

# Python
__pycache__/
scripts/__pycache__/
orchestrator/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/

# System diagnostics (never commit hardware dumps)
dxdiag*.txt
dxdiag*.out

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-*

# Package files
*.egg-info/
.eggs/
.aider*

# Environment files — could contain real secrets
.env
.env.*

# Lumina Scout auto-generated model cache
lumina_scout/cache/

# Lumina Screen runtime / generated artifacts
lumina_screen/chroma_store/
lumina_screen/jd.txt
lumina_screen/page_hit.txt
lumina_screen/processed.json
lumina_screen/resumes/*.pdf
lumina_screen/models/
resumes/
.lumina_run/
open-webui-data/

# ==============================================================================
# Lumina Edge .gitignore
# ==============================================================================

# Model files (all formats)
models/*.gguf
models/*.safetensors
models/*.bin
models/*.pth
models/*.pt
models/*.onnx
models/*.h5
models/*.pb

# Entire model directories except .gitkeep
models/*/
!models/.gitkeep

# Virtual environments — all variants
venv/
env/
.venv/
.env/
venv_rag/
venv_pipeline/
venv_mlx/

# Build directories
bin/
build/
dist/

# Logs and cache
*.log
*.cache
.cache/
logs/
.lumina_run/
vectordb/
vectordb/*.bin
*.sqlite3

# UI build artifacts
ui/dist/
ui/build/
ui/node_modules/
ui/.env
ui/.env.local

# Python
__pycache__/
scripts/__pycache__/
orchestrator/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-*

# Package files
*.egg-info/
.eggs/
.aider*

# Environment files
.env
.env.*
# Lumina Screen runtime / generated artifacts
lumina_screen/chroma_store/
lumina_screen/page_hit.txt
lumina_screen/processed.json
lumina_screen/resumes/test_*.pdf
.lumina_run/
open-webui-data/
